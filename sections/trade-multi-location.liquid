{%- comment -%}
  sections/trade-multi-location.liquid
  Two-column layout: label + headline + body + checklist left;
  two labeled images connected by an arrow right.
  Checklist items are blocks. Both images and their labels are section settings.
{%- endcomment -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="s6trade-multiloc section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}">
  <div class="s6trade-multiloc__inner">

    <div class="s6trade-multiloc__left">
      {%- if section.settings.eyebrow != blank -%}
        <p class="s6trade-multiloc__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="s6trade-multiloc__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <p class="s6trade-multiloc__body">{{ section.settings.body | escape }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="s6trade-multiloc__checklist">
          {%- for block in section.blocks -%}
            {%- if block.type == 'check_item' -%}
              <li class="s6trade-multiloc__check-item" {{ block.shopify_attributes }}>
                <span class="s6trade-multiloc__check-icon" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><polyline points="20 6 9 17 4 12"/></svg>
                </span>
                {{ block.settings.text | escape }}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="s6trade-multiloc__right">
      <div class="s6trade-multiloc__images">

        <div class="s6trade-multiloc__image-item">
          {%- if section.settings.image_1 != blank -%}
            <img
              src="{{ section.settings.image_1 | image_url: width: 700 }}"
              alt="{{ section.settings.image_1.alt | default: section.settings.image_1_label | escape }}"
              class="s6trade-multiloc__img"
              width="{{ section.settings.image_1.width }}"
              height="{{ section.settings.image_1.height }}"
              loading="lazy"
            >
          {%- else -%}
            <div class="s6trade-multiloc__img s6trade-multiloc__img--placeholder"></div>
          {%- endif -%}
          {%- if section.settings.image_1_label != blank -%}
            <p class="s6trade-multiloc__image-label">{{ section.settings.image_1_label | escape }}</p>
          {%- endif -%}
        </div>

        <div class="s6trade-multiloc__arrow" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </div>

        <div class="s6trade-multiloc__image-item">
          {%- if section.settings.image_2 != blank -%}
            <img
              src="{{ section.settings.image_2 | image_url: width: 700 }}"
              alt="{{ section.settings.image_2.alt | default: section.settings.image_2_label | escape }}"
              class="s6trade-multiloc__img"
              width="{{ section.settings.image_2.width }}"
              height="{{ section.settings.image_2.height }}"
              loading="lazy"
            >
          {%- else -%}
            <div class="s6trade-multiloc__img s6trade-multiloc__img--placeholder"></div>
          {%- endif -%}
          {%- if section.settings.image_2_label != blank -%}
            <p class="s6trade-multiloc__image-label">{{ section.settings.image_2_label | escape }}</p>
          {%- endif -%}
        </div>

      </div>
    </div>

  </div>
</div>

{% stylesheet %}
  .s6trade-multiloc {
    padding-block: clamp(56px, 7vw, 96px);
  }
  .s6trade-multiloc__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: center;
  }
  @media screen and (min-width: 900px) {
    .s6trade-multiloc__inner {
      grid-template-columns: 1fr 1fr;
      gap: 80px;
    }
  }
  .s6trade-multiloc__left {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .s6trade-multiloc__eyebrow {
    font-family: var(--font-accent--family);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-foreground-muted);
    margin: 0;
  }
  .s6trade-multiloc__heading {
    font-family: var(--font-heading--family);
    font-size: clamp(26px, 3vw, 40px);
    font-weight: 600;
    line-height: 1.1;
    margin: 0;
    color: var(--color-foreground-heading);
  }
  .s6trade-multiloc__body {
    font-family: var(--font-body--family);
    font-size: 16px;
    line-height: 1.65;
    color: var(--color-foreground);
    margin: 0;
    max-width: 46ch;
  }
  .s6trade-multiloc__checklist {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .s6trade-multiloc__check-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-body--family);
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-foreground);
  }
  .s6trade-multiloc__check-icon {
    flex-shrink: 0;
    color: var(--color-foreground-heading);
    line-height: 0;
  }
  .s6trade-multiloc__images {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .s6trade-multiloc__image-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .s6trade-multiloc__img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    display: block;
    background: var(--color-border);
  }
  .s6trade-multiloc__img--placeholder {
    height: 0;
    padding-block-end: 133%;
  }
  .s6trade-multiloc__image-label {
    font-family: var(--font-accent--family);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-foreground-heading);
    margin: 0;
  }
  .s6trade-multiloc__arrow {
    flex-shrink: 0;
    color: var(--color-foreground-muted);
    line-height: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trade — Multi-Location",
  "tag": "section",
  "class": "s6trade-multiloc-wrapper section-wrapper",
  "disabled_on": { "groups": ["header", "footer"] },
  "blocks": [
    {
      "type": "check_item",
      "name": "Checklist item",
      "settings": [
        { "type": "text", "id": "text", "label": "Item text", "default": "Checklist item" }
      ]
    }
  ],
  "settings": [
    { "type": "header", "content": "Copy" },
    { "type": "text",     "id": "eyebrow",  "label": "Section label", "default": "MULTI-LOCATION PROGRAMS" },
    { "type": "text",     "id": "heading",  "label": "Headline",      "default": "Art programs that scale with you." },
    { "type": "textarea", "id": "body",     "label": "Body",          "default": "We make it easy to maintain a cohesive look across multiple locations with:" },
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "image_1",       "label": "Image 1" },
    { "type": "text",         "id": "image_1_label", "label": "Image 1 label", "default": "HEADQUARTERS" },
    { "type": "image_picker", "id": "image_2",       "label": "Image 2" },
    { "type": "text",         "id": "image_2_label", "label": "Image 2 label", "default": "MULTIPLE LOCATIONS" },
    { "type": "header", "content": "Section appearance" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-trade-cream" }
  ],
  "presets": [
    {
      "name": "Trade — Multi-Location",
      "blocks": [
        { "type": "check_item", "settings": { "text": "Standardized sourcing" } },
        { "type": "check_item", "settings": { "text": "Coordinated production" } },
        { "type": "check_item", "settings": { "text": "Consistent quality & timelines" } },
        { "type": "check_item", "settings": { "text": "Simplified ordering & delivery" } }
      ]
    }
  ]
}
{% endschema %}
