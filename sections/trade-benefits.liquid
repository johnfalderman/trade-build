{%- comment -%}
  sections/trade-benefits.liquid
  Section header + 3-column grid of trade-benefit blocks (1-column mobile).
  Default 6 benefits per copy/rewrites.md.
{%- endcomment -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="trade-benefits section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}">
  <div class="trade-benefits__header">
    {%- if section.settings.eyebrow != blank -%}
      <p class="trade-benefits__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="trade-benefits__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
  </div>
  <div class="trade-benefits__grid">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .trade-benefits {
    padding-block: clamp(48px, 6vw, 80px);
  }
  .trade-benefits__header {
    text-align: center;
    max-width: 720px;
    margin-inline: auto;
    margin-block-end: 56px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .trade-benefits__eyebrow {
    font-family: var(--font-accent--family);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-foreground-muted);
    margin: 0;
  }
  .trade-benefits__heading {
    font-family: var(--font-heading--family);
    font-size: clamp(28px, 3.4vw, 44px);
    font-weight: 600;
    line-height: 1.1;
    margin: 0;
    color: var(--color-foreground-heading);
  }
  .trade-benefits__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px 32px;
  }
  @media screen and (min-width: 750px) {
    .trade-benefits__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 48px 40px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trade Benefits",
  "tag": "section",
  "class": "trade-benefits-wrapper section-wrapper",
  "disabled_on": { "groups": ["header"] },
  "blocks": [ { "type": "trade-benefit" } ],
  "max_blocks": 9,
  "settings": [
    { "type": "header", "content": "Section header" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What's Included" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built for the way designers actually work." },
    { "type": "header", "content": "Section appearance" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-trade-cream" }
  ]
}
{% endschema %}
