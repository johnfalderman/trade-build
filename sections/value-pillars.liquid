{%- comment -%}
  sections/value-pillars.liquid
  Thin horizontal strip of value-pillar blocks. Optional centered
  section header (heading + subhead, both blank by default).
  Defaults to 4-col desktop / 2x2 mobile grid; adapts to block count.
  Reusable on any S6 page.
{%- endcomment -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="value-pillars section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}">
  {%- if section.settings.heading != blank or section.settings.subhead != blank -%}
    <div class="value-pillars__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="value-pillars__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subhead != blank -%}
        <div class="value-pillars__subhead">{{ section.settings.subhead }}</div>
      {%- endif -%}
    </div>
  {%- endif -%}
  <div class="value-pillars__grid">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .value-pillars {
    padding-block: clamp(48px, 6vw, 64px);
  }
  .value-pillars__header {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
    margin-block-end: 32px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .value-pillars__heading {
    font-family: var(--font-heading--family);
    font-size: clamp(22px, 2.4vw, 28px);
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-foreground-heading);
    margin: 0;
  }
  .value-pillars__subhead {
    font-family: var(--font-body--family);
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-foreground-muted);
  }
  .value-pillars__subhead :where(p) { margin: 0; }
  .value-pillars__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  @media screen and (min-width: 750px) {
    .value-pillars__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Value Pillars",
  "tag": "section",
  "class": "value-pillars-wrapper section-wrapper",
  "disabled_on": { "groups": ["header"] },
  "blocks": [ { "type": "value-pillar" } ],
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Section header (optional)" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "subhead", "label": "Subhead" },
    { "type": "header", "content": "Section appearance" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-trade-cream" }
  ]
}
{% endschema %}
