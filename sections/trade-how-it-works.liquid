{%- comment -%}
  sections/trade-how-it-works.liquid
  Two parallel columns (Self-Serve / Full-Service paths). Each column has
  an eyebrow subhead, three numbered steps, and an optional CTA button at
  the bottom. The six _trade-how-step child blocks are split 3+3 between
  columns by block index (1-3 = left, 4-6 = right).
{%- endcomment -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="trade-how section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}">
  <div class="trade-how__header">
    {%- if section.settings.eyebrow != blank -%}
      <p class="trade-how__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="trade-how__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
  </div>

  <div class="trade-how__columns">
    {%- assign step_blocks = section.blocks | where: 'type', '_trade-how-step' -%}
    <div class="trade-how__column">
      <div class="trade-how__col-head">
        <p class="trade-how__col-title">{{ section.settings.col1_title | default: 'Self-Serve Path' | escape }}</p>
        {%- if section.settings.col1_subhead != blank -%}
          <p class="trade-how__col-sub">{{ section.settings.col1_subhead | escape }}</p>
        {%- endif -%}
      </div>
      <div class="trade-how__steps">
        {%- for b in step_blocks limit: 3 -%}
          {%- render b -%}
        {%- endfor -%}
      </div>
      {%- if section.settings.col1_cta_label != blank and section.settings.col1_cta_link != blank -%}
        <a class="trade-how__cta" href="{{ section.settings.col1_cta_link }}">{{ section.settings.col1_cta_label | escape }}</a>
      {%- endif -%}
    </div>

    <div class="trade-how__column">
      <div class="trade-how__col-head">
        <p class="trade-how__col-title">{{ section.settings.col2_title | default: 'Full-Service Path' | escape }}</p>
        {%- if section.settings.col2_subhead != blank -%}
          <p class="trade-how__col-sub">{{ section.settings.col2_subhead | escape }}</p>
        {%- endif -%}
      </div>
      <div class="trade-how__steps">
        {%- for b in step_blocks offset: 3 limit: 3 -%}
          {%- render b -%}
        {%- endfor -%}
      </div>
      {%- if section.settings.col2_cta_label != blank and section.settings.col2_cta_link != blank -%}
        <a class="trade-how__cta trade-how__cta--secondary" href="{{ section.settings.col2_cta_link }}">{{ section.settings.col2_cta_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .trade-how {
    padding-block: clamp(48px, 6vw, 80px);
  }
  .trade-how__header {
    text-align: center;
    max-width: 720px;
    margin-inline: auto;
    margin-block-end: 64px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .trade-how__eyebrow {
    font-family: var(--font-accent--family);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-foreground-muted);
    margin: 0;
  }
  .trade-how__heading {
    font-family: var(--font-heading--family);
    font-size: clamp(28px, 3.4vw, 44px);
    font-weight: 600;
    line-height: 1.1;
    margin: 0;
    color: var(--color-foreground-heading);
  }
  .trade-how__columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: 56px;
  }
  @media screen and (min-width: 750px) {
    .trade-how__columns {
      grid-template-columns: 1fr 1fr;
      gap: 64px;
    }
  }
  .trade-how__column {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .trade-how__col-head {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-block-end: 24px;
    border-block-end: 1px solid var(--color-border);
  }
  .trade-how__col-title {
    font-family: var(--font-accent--family);
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-foreground-heading);
    margin: 0;
  }
  .trade-how__col-sub {
    font-family: var(--font-body--family);
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-foreground-muted);
    margin: 0;
  }
  .trade-how__steps {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .trade-how__cta {
    align-self: flex-start;
    margin-block-start: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-primary-button-background);
    color: var(--color-primary-button-text);
    border: 1.5px solid var(--color-primary-button-border);
    border-radius: 0;
    padding: 16px 32px;
    font-family: var(--font-body--family);
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    text-decoration: none;
  }
  .trade-how__cta:hover {
    background: var(--color-primary-button-hover-background);
    color: var(--color-primary-button-hover-text);
    border-color: var(--color-primary-button-hover-border);
  }
  .trade-how__cta--secondary {
    background: var(--color-secondary-button-background);
    color: var(--color-secondary-button-text);
    border-color: var(--color-secondary-button-border);
  }
  .trade-how__cta--secondary:hover {
    background: var(--color-secondary-button-hover-background);
    color: var(--color-secondary-button-hover-text);
    border-color: var(--color-secondary-button-hover-border);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trade How It Works",
  "tag": "section",
  "class": "trade-how-wrapper section-wrapper",
  "disabled_on": { "groups": ["header"] },
  "blocks": [ { "type": "_trade-how-step" } ],
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Section header" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How It Works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pick your path. Both end with art on the wall." },
    { "type": "header", "content": "Column 1 (left) — Self-Serve" },
    { "type": "text", "id": "col1_title", "label": "Title", "default": "Self-Serve Path" },
    { "type": "text", "id": "col1_subhead", "label": "Subhead", "default": "For when you want full control" },
    { "type": "text", "id": "col1_cta_label", "label": "CTA label" },
    { "type": "url", "id": "col1_cta_link", "label": "CTA link" },
    { "type": "header", "content": "Column 2 (right) — Full-Service" },
    { "type": "text", "id": "col2_title", "label": "Title", "default": "Full-Service Path" },
    { "type": "text", "id": "col2_subhead", "label": "Subhead", "default": "For when you want it done for you" },
    { "type": "text", "id": "col2_cta_label", "label": "CTA label" },
    { "type": "url", "id": "col2_cta_link", "label": "CTA link" },
    { "type": "header", "content": "Section appearance" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-trade-cream" }
  ]
}
{% endschema %}
