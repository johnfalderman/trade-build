{%- comment -%}
  sections/trade-explore-blocks.liquid
  Section header + 3-column grid of trade-explore-block cards (1-column
  mobile, gap 16-24px).
{%- endcomment -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="trade-explore-section section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}">
  <div class="trade-explore-section__header">
    {%- if section.settings.eyebrow != blank -%}
      <p class="trade-explore-section__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="trade-explore-section__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
  </div>
  <div class="trade-explore-section__grid">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .trade-explore-section {
    padding-block: clamp(64px, 8vw, 112px);
  }
  .trade-explore-section__header {
    text-align: center;
    max-width: 720px;
    margin-inline: auto;
    margin-block-end: 48px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .trade-explore-section__eyebrow {
    font-family: var(--font-accent--family);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-foreground-muted);
    margin: 0;
  }
  .trade-explore-section__heading {
    font-family: var(--font-heading--family);
    font-size: clamp(28px, 3.4vw, 44px);
    font-weight: 600;
    line-height: 1.1;
    margin: 0;
    color: var(--color-foreground-heading);
  }
  .trade-explore-section__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media screen and (min-width: 750px) {
    .trade-explore-section__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trade Explore Blocks",
  "tag": "section",
  "class": "trade-explore-blocks-wrapper section-wrapper",
  "disabled_on": { "groups": ["header"] },
  "blocks": [ { "type": "trade-explore-block" } ],
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Section header" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Explore" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Start with what fits your project." },
    { "type": "header", "content": "Section appearance" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-trade-cream" }
  ]
}
{% endschema %}
