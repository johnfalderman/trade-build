{%- comment -%}
  sections/trade-final-cta.liquid
  Centered eyebrow + heading + subhead + dual CTAs on cream-2
  (#f1ebe2) background. cream-2 is hardcoded because we don't have a
  separate scheme for it yet — settings_data.json edits are ask-first.
  Buttons inherit the scheme's primary/secondary button colors.
{%- endcomment -%}

<div class="trade-final-cta-bg color-{{ section.settings.color_scheme }}"></div>
<div class="trade-final-cta section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}">
  <div class="trade-final-cta__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="trade-final-cta__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="trade-final-cta__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.subhead != blank -%}
      <div class="trade-final-cta__subhead">{{ section.settings.subhead }}</div>
    {%- endif -%}
    <div class="trade-final-cta__buttons">
      {%- if section.settings.primary_label != blank and section.settings.primary_link != blank -%}
        <a class="trade-final-cta__btn trade-final-cta__btn--primary" href="{{ section.settings.primary_link }}">
          {{- section.settings.primary_label | escape -}}
        </a>
      {%- endif -%}
      {%- if section.settings.secondary_label != blank and section.settings.secondary_link != blank -%}
        <a class="trade-final-cta__btn trade-final-cta__btn--secondary" href="{{ section.settings.secondary_link }}">
          {{- section.settings.secondary_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .trade-final-cta-bg {
    background: #f1ebe2;
    grid-column: 1 / -1;
    grid-row: 1 / 2;
  }
  .trade-final-cta {
    padding-block: clamp(64px, 8vw, 112px);
    background: #f1ebe2;
  }
  .trade-final-cta__inner {
    max-width: 720px;
    margin-inline: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: center;
  }
  .trade-final-cta__eyebrow {
    font-family: var(--font-accent--family);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-foreground-muted);
    margin: 0;
  }
  .trade-final-cta__heading {
    font-family: var(--font-heading--family);
    font-size: clamp(28px, 3.4vw, 44px);
    font-weight: 600;
    line-height: 1.1;
    margin: 0;
    color: var(--color-foreground-heading);
  }
  .trade-final-cta__subhead {
    font-family: var(--font-body--family);
    font-size: 17px;
    line-height: 1.55;
    color: var(--color-foreground);
    max-width: 56ch;
  }
  .trade-final-cta__subhead :where(p) { margin: 0; }
  .trade-final-cta__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-block-start: 16px;
  }
  .trade-final-cta__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 0;
    padding: 16px 32px;
    font-family: var(--font-body--family);
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .trade-final-cta__btn--primary {
    background: var(--color-primary-button-background);
    color: var(--color-primary-button-text);
    border: 1.5px solid var(--color-primary-button-border);
  }
  .trade-final-cta__btn--primary:hover {
    background: var(--color-primary-button-hover-background);
    color: var(--color-primary-button-hover-text);
    border-color: var(--color-primary-button-hover-border);
  }
  .trade-final-cta__btn--secondary {
    background: var(--color-secondary-button-background);
    color: var(--color-secondary-button-text);
    border: 1.5px solid var(--color-secondary-button-border);
  }
  .trade-final-cta__btn--secondary:hover {
    background: var(--color-secondary-button-hover-background);
    color: var(--color-secondary-button-hover-text);
    border-color: var(--color-secondary-button-hover-border);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trade Final CTA",
  "tag": "section",
  "class": "trade-final-cta-wrapper section-wrapper",
  "disabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Ready When You Are" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Apply for trade access in under two minutes." },
    { "type": "richtext", "id": "subhead", "label": "Subhead" },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Join Trade Program" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Request a Curated Collection" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" },
    { "type": "header", "content": "Section appearance" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "full-width"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-trade-cream" }
  ]
}
{% endschema %}
