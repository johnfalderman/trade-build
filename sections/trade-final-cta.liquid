{%- comment -%}
  sections/trade-final-cta.liquid
  Horizontal bottom bar: wordmark left, headline + body center, CTA right.
  Full-width on desktop; stacks to column on mobile (wordmark top, CTA bottom).
{%- endcomment -%}

{%- assign cta_url = section.settings.cta_link | default: '/pages/trade-application' -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="s6trade-final-cta section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}">
  <div class="s6trade-final-cta__inner">

    {%- if section.settings.wordmark != blank -%}
      <p class="s6trade-final-cta__wordmark">{{ section.settings.wordmark | escape }}</p>
    {%- endif -%}

    <div class="s6trade-final-cta__copy">
      {%- if section.settings.heading != blank -%}
        <h2 class="s6trade-final-cta__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <p class="s6trade-final-cta__body">{{ section.settings.body | escape }}</p>
      {%- endif -%}
    </div>

    {%- if section.settings.cta_label != blank -%}
      <div class="s6trade-final-cta__action">
        <a class="s6trade-final-cta__btn" href="{{ cta_url }}">
          {{- section.settings.cta_label | escape -}}
        </a>
      </div>
    {%- endif -%}

  </div>
</div>

{% stylesheet %}
  .s6trade-final-cta {
    padding-block: clamp(40px, 5vw, 64px);
    background: #f1ebe2;
  }
  .s6trade-final-cta__inner {
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-items: flex-start;
  }
  @media screen and (min-width: 900px) {
    .s6trade-final-cta__inner {
      flex-direction: row;
      align-items: center;
      gap: 48px;
    }
  }
  .s6trade-final-cta__wordmark {
    font-family: var(--font-heading--family);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-foreground-heading);
    margin: 0;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .s6trade-final-cta__copy {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .s6trade-final-cta__heading {
    font-family: var(--font-heading--family);
    font-size: clamp(20px, 2.2vw, 28px);
    font-weight: 600;
    line-height: 1.15;
    margin: 0;
    color: var(--color-foreground-heading);
  }
  .s6trade-final-cta__body {
    font-family: var(--font-body--family);
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-foreground);
    margin: 0;
    max-width: 56ch;
  }
  .s6trade-final-cta__action {
    flex-shrink: 0;
  }
  .s6trade-final-cta__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-primary-button-background);
    color: var(--color-primary-button-text);
    border: 1.5px solid var(--color-primary-button-border);
    border-radius: 0;
    padding: 16px 32px;
    font-family: var(--font-body--family);
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }
  .s6trade-final-cta__btn:hover {
    background: var(--color-primary-button-hover-background);
    color: var(--color-primary-button-hover-text);
    border-color: var(--color-primary-button-hover-border);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trade Final CTA",
  "tag": "section",
  "class": "s6trade-final-cta-wrapper section-wrapper",
  "disabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "header", "content": "Copy" },
    { "type": "text",     "id": "wordmark",  "label": "Wordmark / logo text", "default": "Society6 Trade" },
    { "type": "text",     "id": "heading",   "label": "Headline",             "default": "Join the Society6 Trade Program" },
    { "type": "textarea", "id": "body",      "label": "Body",                 "default": "Access exclusive pricing, curated sourcing support, and scalable art solutions for projects of every size." },
    { "type": "text",     "id": "cta_label", "label": "CTA button text",      "default": "JOIN TRADE" },
    { "type": "url",      "id": "cta_link",  "label": "CTA button link" },
    { "type": "header", "content": "Section appearance" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "full-width"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-trade-cream" }
  ]
}
{% endschema %}
