{%- comment -%}
  sections/trade-how-we-work.liquid
  Two-column layout: eyebrow + headline left, process steps right.
  Steps are blocks (max 5) so Stephanie can add, remove, or reorder in
  the customizer. Arrows render between steps on desktop; steps stack
  vertically on mobile with no arrows.
{%- endcomment -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="s6trade-how section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}">
  <div class="s6trade-how__inner">

    <div class="s6trade-how__left">
      {%- if section.settings.eyebrow != blank -%}
        <p class="s6trade-how__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="s6trade-how__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="s6trade-how__right">
        <div class="s6trade-how__steps">
          {%- for block in section.blocks -%}
            {%- if block.type == 'step' -%}
              <div class="s6trade-how__step" {{ block.shopify_attributes }}>
                {%- if block.settings.label != blank -%}
                  <p class="s6trade-how__step-label">{{ block.settings.label | escape }}</p>
                {%- endif -%}
                {%- if block.settings.body != blank -%}
                  <p class="s6trade-how__step-body">{{ block.settings.body | escape }}</p>
                {%- endif -%}
              </div>
              {%- unless forloop.last -%}
                <div class="s6trade-how__arrow" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false">
                    <line x1="5" y1="12" x2="19" y2="12"/>
                    <polyline points="12 5 19 12 12 19"/>
                  </svg>
                </div>
              {%- endunless -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

  </div>
</div>

{% stylesheet %}
  .s6trade-how {
    padding-block: clamp(56px, 7vw, 96px);
  }
  .s6trade-how__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: start;
  }
  @media screen and (min-width: 900px) {
    .s6trade-how__inner {
      grid-template-columns: 1fr 2fr;
      gap: 80px;
      align-items: center;
    }
  }
  .s6trade-how__left {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .s6trade-how__eyebrow {
    font-family: var(--font-accent--family);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-foreground-muted);
    margin: 0;
  }
  .s6trade-how__heading {
    font-family: var(--font-heading--family);
    font-size: clamp(26px, 3vw, 40px);
    font-weight: 600;
    line-height: 1.1;
    margin: 0;
    color: var(--color-foreground-heading);
  }
  .s6trade-how__steps {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  @media screen and (min-width: 600px) {
    .s6trade-how__steps {
      flex-direction: row;
      align-items: flex-start;
      gap: 0;
    }
  }
  .s6trade-how__step {
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }
  @media screen and (min-width: 600px) {
    .s6trade-how__step {
      padding-inline-end: 20px;
    }
  }
  .s6trade-how__step-label {
    font-family: var(--font-accent--family);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-foreground-heading);
    margin: 0;
  }
  .s6trade-how__step-body {
    font-family: var(--font-body--family);
    font-size: 15px;
    line-height: 1.65;
    color: var(--color-foreground);
    margin: 0;
  }
  .s6trade-how__arrow {
    display: none;
  }
  @media screen and (min-width: 600px) {
    .s6trade-how__arrow {
      display: flex;
      align-items: flex-start;
      padding-block-start: 1px;
      padding-inline: 4px;
      flex-shrink: 0;
      color: var(--color-foreground-muted);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trade — How We Work",
  "tag": "section",
  "class": "s6trade-how-wrapper section-wrapper",
  "disabled_on": { "groups": ["header", "footer"] },
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 5,
      "settings": [
        { "type": "text",     "id": "label", "label": "Step label",       "default": "STEP" },
        { "type": "textarea", "id": "body",  "label": "Step description", "default": "Describe this step in one or two sentences." }
      ]
    }
  ],
  "settings": [
    { "type": "header", "content": "Section copy" },
    { "type": "text", "id": "eyebrow",  "label": "Section label", "default": "HOW WE WORK" },
    { "type": "text", "id": "heading",  "label": "Headline",      "default": "Sourcing art should be simple (and inspiring)." },
    { "type": "header", "content": "Section appearance" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-trade-cream" }
  ],
  "presets": [
    {
      "name": "Trade — How We Work",
      "blocks": [
        { "type": "step", "settings": { "label": "SOURCE", "body": "Explore thousands of independent artist designs across art prints, wall decor, textiles, and more." } },
        { "type": "step", "settings": { "label": "CURATE", "body": "Our team helps you find the right pieces that fit your style, budget, and project goals." } },
        { "type": "step", "settings": { "label": "SCALE",  "body": "We handle production and delivery across multiple locations with consistent quality and ease." } }
      ]
    }
  ]
}
{% endschema %}
