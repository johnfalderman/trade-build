{%- comment -%}
  sections/trade-case-studies-grid.liquid
  Section header + 3-column grid of trade-case-study-card blocks (1-col
  mobile). Used on /pages/trade-program between the clients row and the
  explore-blocks section.
{%- endcomment -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="trade-cs-grid section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}">
  <div class="trade-cs-grid__header">
    {%- if section.settings.eyebrow != blank -%}
      <p class="trade-cs-grid__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="trade-cs-grid__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.subhead != blank -%}
      <div class="trade-cs-grid__subhead">{{ section.settings.subhead }}</div>
    {%- endif -%}
  </div>
  <div class="trade-cs-grid__grid">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .trade-cs-grid {
    padding-block: clamp(48px, 6vw, 80px);
  }
  .trade-cs-grid__header {
    text-align: center;
    max-width: 720px;
    margin-inline: auto;
    margin-block-end: 56px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .trade-cs-grid__eyebrow {
    font-family: var(--font-accent--family);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-foreground-muted);
    margin: 0;
  }
  .trade-cs-grid__heading {
    font-family: var(--font-heading--family);
    font-size: clamp(28px, 3.4vw, 44px);
    font-weight: 600;
    line-height: 1.1;
    margin: 0;
    color: var(--color-foreground-heading);
  }
  .trade-cs-grid__subhead {
    font-family: var(--font-body--family);
    font-size: 17px;
    line-height: 1.55;
    color: var(--color-foreground);
    max-width: 56ch;
    margin-inline: auto;
  }
  .trade-cs-grid__subhead :where(p) { margin: 0; }
  .trade-cs-grid__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
  @media screen and (min-width: 750px) {
    .trade-cs-grid__grid { grid-template-columns: repeat(3, 1fr); gap: 28px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trade Case Studies Grid",
  "tag": "section",
  "class": "trade-cs-grid-wrapper section-wrapper",
  "disabled_on": { "groups": ["header"] },
  "blocks": [ { "type": "trade-case-study-card" } ],
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Section header" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Case Studies" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real projects, real designers." },
    { "type": "richtext", "id": "subhead", "label": "Subhead" },
    { "type": "header", "content": "Section appearance" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-trade-cream" }
  ]
}
{% endschema %}
