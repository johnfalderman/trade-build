{%- comment -%}
  sections/trade-catalog-gate.liquid
  PDF catalog email-gate. 2-column layout (page-width): copy + email
  signup on the left, vertical book-cover image on the right. Reuses
  blocks/email-signup.liquid as a static block. Mobile stacks copy
  above image.
{%- endcomment -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  id="catalog"
  class="trade-catalog section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
>
  <div class="trade-catalog__grid">
    <div class="trade-catalog__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="trade-catalog__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="trade-catalog__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subhead != blank -%}
        <div class="trade-catalog__subhead">{{ section.settings.subhead }}</div>
      {%- endif -%}
      <div class="trade-catalog__form">
        {% content_for 'block', type: 'email-signup', id: 'catalog-signup' %}
      </div>
      {%- if section.settings.fineprint != blank -%}
        <p class="trade-catalog__fineprint">{{ section.settings.fineprint | escape }}</p>
      {%- endif -%}
    </div>

    <div class="trade-catalog__media">
      {%- if section.settings.cover_image != blank -%}
        {{ section.settings.cover_image | image_url: width: 900 | image_tag:
          widths: '400, 600, 800, 900',
          sizes: '(min-width: 750px) 40vw, 80vw',
          alt: 'Trade Catalog cover',
          loading: 'lazy',
          class: 'trade-catalog__cover'
        }}
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .trade-catalog {
    padding-block: clamp(64px, 8vw, 112px);
  }
  .trade-catalog__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: center;
  }
  @media screen and (min-width: 750px) {
    .trade-catalog__grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 64px;
    }
  }
  .trade-catalog__copy {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .trade-catalog__eyebrow {
    font-family: var(--font-accent--family);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-foreground-muted);
    margin: 0;
  }
  .trade-catalog__heading {
    font-family: var(--font-heading--family);
    font-size: clamp(28px, 3.4vw, 44px);
    font-weight: 600;
    line-height: 1.1;
    margin: 0;
    color: var(--color-foreground-heading);
  }
  .trade-catalog__subhead {
    font-family: var(--font-body--family);
    font-size: 17px;
    line-height: 1.55;
    color: var(--color-foreground);
  }
  .trade-catalog__subhead :where(p) { margin: 0; }
  .trade-catalog__form {
    margin-block-start: 16px;
    max-width: 480px;
  }
  .trade-catalog__fineprint {
    font-family: var(--font-body--family);
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-foreground-muted);
    max-width: 480px;
    margin: 8px 0 0 0;
  }
  .trade-catalog__media {
    order: -1;
  }
  @media screen and (min-width: 750px) {
    .trade-catalog__media { order: 0; }
  }
  .trade-catalog__cover {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    box-shadow: 0 20px 40px rgba(0,0,0,0.15);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trade Catalog Gate",
  "tag": "section",
  "class": "trade-catalog-wrapper section-wrapper",
  "disabled_on": { "groups": ["header"] },
  "blocks": [
    { "type": "email-signup" }
  ],
  "settings": [
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Free Download" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get the 2026 Trade Catalog." },
    { "type": "richtext", "id": "subhead", "label": "Subhead" },
    { "type": "text", "id": "fineprint", "label": "Fineprint" },
    { "type": "header", "content": "Media" },
    { "type": "image_picker", "id": "cover_image", "label": "Cover image" },
    { "type": "header", "content": "Section appearance" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-trade-cream" }
  ]
}
{% endschema %}
