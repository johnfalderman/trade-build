{%- comment -%}
  sections/trade-newsletter.liquid
  Trade-only newsletter band that sits above the standard footer
  on /pages/trade-program. Dark (#000000) background, light text.
  Reuses blocks/email-signup.liquid as a static block. Designed to
  replace the consumer 20%-off popup on this page specifically
  (popup suppression itself is a layout/theme.liquid edit, handled
  separately).
{%- endcomment -%}

<div class="trade-newsletter">
  <div class="trade-newsletter__inner">
    <div class="trade-newsletter__copy">
      {%- if section.settings.heading != blank -%}
        <h2 class="trade-newsletter__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <p class="trade-newsletter__body">{{ section.settings.body | escape }}</p>
      {%- endif -%}
    </div>
    <div class="trade-newsletter__form">
      {% content_for 'block', type: 'email-signup', id: 'newsletter-signup' %}
    </div>
  </div>
</div>

{% stylesheet %}
  .trade-newsletter {
    background: #000000;
    color: #ffffff;
    padding-block: clamp(40px, 5vw, 64px);
    padding-inline: var(--page-margin, clamp(20px, 4vw, 56px));
  }
  .trade-newsletter__inner {
    max-width: 1280px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: center;
  }
  @media screen and (min-width: 750px) {
    .trade-newsletter__inner {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 64px;
    }
  }
  .trade-newsletter__copy {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .trade-newsletter__heading {
    font-family: var(--font-heading--family);
    font-size: clamp(24px, 2.6vw, 32px);
    font-weight: 600;
    line-height: 1.2;
    color: #ffffff;
    margin: 0;
  }
  .trade-newsletter__body {
    font-family: var(--font-body--family);
    font-size: 15px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.75);
    margin: 0;
  }
  /* Force email-signup input/button to read on dark background */
  .trade-newsletter__form .email-signup__input {
    background: rgba(255,255,255,0.06);
    color: #ffffff;
    border-color: rgba(255,255,255,0.35);
  }
  .trade-newsletter__form .email-signup__input::placeholder {
    color: rgba(255,255,255,0.55);
  }
  .trade-newsletter__form .email-signup__button {
    background: #ffffff;
    color: #000000;
    border-color: #ffffff;
  }
  .trade-newsletter__form .email-signup__button:hover {
    background: rgba(255,255,255,0.85);
    color: #000000;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trade Newsletter Band",
  "tag": "section",
  "class": "trade-newsletter-wrapper",
  "disabled_on": { "groups": ["header"] },
  "blocks": [
    { "type": "email-signup" }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stay in the Trade Loop" },
    { "type": "text", "id": "body", "label": "Body", "default": "Trade-only drops, curation tips, and project inspiration. No consumer promos." }
  ]
}
{% endschema %}
