{%- comment -%}
  sections/trade-lookbook-modal.liquid
  Email-gated lookbook modal. Opened by any link on the page whose
  href is #trade-lookbook (hero secondary CTA, full-service path card
  button, final-CTA secondary, explore-row catalog card).

  Uses native {% form 'customer' %} so the lead is captured as a
  Shopify customer record tagged trade-catalog-lead. On submit the
  page reloads; if this form posted successfully, we render an
  auto-open flag the inline script reads on DOMContentLoaded so the
  modal re-opens in its success state with the PDF link.

  Production gap: lead destination here is Shopify customer records.
  Production likely routes to Salesforce/Klaviyo — when porting,
  swap the {% form %} block below; everything else (markup, modal,
  success state) is reusable.
{%- endcomment -%}

{%- assign pdf_url = section.settings.pdf_url -%}

<dialog
  id="trade-lookbook"
  class="s6trade-lookbook-modal"
  aria-labelledby="s6trade-lookbook-heading"
>
  <div class="s6trade-lookbook-modal__panel" role="document">
    <button
      type="button"
      class="s6trade-lookbook-modal__close"
      aria-label="Close"
      data-trade-lookbook-close
    >
      <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false">
        <path d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/>
      </svg>
    </button>

    {%- form 'customer', class: 's6trade-lookbook-modal__form' -%}
      <input type="hidden" name="contact[tags]" value="trade-catalog-lead">

      {%- if form.posted_successfully? -%}
        <div class="s6trade-lookbook-modal__success" data-trade-lookbook-success>
          <h2 id="s6trade-lookbook-heading" class="s6trade-lookbook-modal__heading">
            {{ section.settings.success_heading | escape }}
          </h2>
          <div class="s6trade-lookbook-modal__body">{{ section.settings.success_body }}</div>
          {%- if pdf_url != blank -%}
            <a
              class="s6trade-lookbook-modal__download"
              href="{{ pdf_url }}"
              target="_blank"
              rel="noopener"
            >
              {{ section.settings.success_link_label | escape }}
            </a>
          {%- endif -%}
        </div>
      {%- else -%}
        <p class="s6trade-lookbook-modal__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h2 id="s6trade-lookbook-heading" class="s6trade-lookbook-modal__heading">
          {{ section.settings.heading | escape }}
        </h2>
        <div class="s6trade-lookbook-modal__body">{{ section.settings.description }}</div>
        <p class="s6trade-lookbook-modal__microcopy">{{ section.settings.microcopy }}</p>

        <div class="s6trade-lookbook-modal__fields">
          <label class="s6trade-lookbook-modal__field">
            <span class="s6trade-lookbook-modal__label">Email</span>
            <input
              type="email"
              name="contact[email]"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              required
            >
          </label>
          <label class="s6trade-lookbook-modal__field">
            <span class="s6trade-lookbook-modal__label">Phone (optional)</span>
            <input
              type="tel"
              name="contact[phone]"
              autocomplete="tel"
            >
          </label>
        </div>

        {%- if form.errors -%}
          <div class="s6trade-lookbook-modal__error" role="alert">
            {{- form.errors | default_errors -}}
          </div>
        {%- endif -%}

        <button type="submit" class="s6trade-lookbook-modal__submit">
          {{ section.settings.submit_label | escape }}
        </button>

        <p class="s6trade-lookbook-modal__fineprint">{{ section.settings.fineprint | escape }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</dialog>

{% stylesheet %}
  .s6trade-lookbook-modal {
    padding: 0;
    border: none;
    background: transparent;
    max-width: 560px;
    width: calc(100vw - 32px);
    color: var(--color-foreground);
  }
  .s6trade-lookbook-modal::backdrop {
    background: rgba(20, 18, 14, 0.55);
  }
  .s6trade-lookbook-modal[open] {
    display: block;
  }
  .s6trade-lookbook-modal__panel {
    position: relative;
    background: #faf6ef;
    padding: clamp(28px, 4vw, 44px);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.25);
  }
  .s6trade-lookbook-modal__close {
    position: absolute;
    top: 12px;
    right: 12px;
    background: transparent;
    border: none;
    padding: 8px;
    cursor: pointer;
    color: var(--color-foreground);
    line-height: 0;
  }
  .s6trade-lookbook-modal__close:hover {
    color: var(--color-foreground-heading);
  }
  .s6trade-lookbook-modal__form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .s6trade-lookbook-modal__eyebrow {
    font-family: var(--font-accent--family);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-foreground-muted);
    margin: 0;
  }
  .s6trade-lookbook-modal__heading {
    font-family: var(--font-heading--family);
    font-size: clamp(24px, 2.6vw, 30px);
    font-weight: 600;
    line-height: 1.15;
    margin: 0;
    color: var(--color-foreground-heading);
  }
  .s6trade-lookbook-modal__body {
    font-family: var(--font-body--family);
    font-size: 16px;
    line-height: 1.55;
  }
  .s6trade-lookbook-modal__body :where(p) { margin: 0; }
  .s6trade-lookbook-modal__microcopy {
    font-family: var(--font-body--family);
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-foreground-muted);
    margin: 4px 0 0;
  }
  .s6trade-lookbook-modal__fields {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-block-start: 8px;
  }
  .s6trade-lookbook-modal__field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .s6trade-lookbook-modal__label {
    font-family: var(--font-body--family);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-foreground);
  }
  .s6trade-lookbook-modal__field input {
    font-family: var(--font-body--family);
    font-size: 15px;
    padding: 12px 14px;
    border: 1px solid var(--color-border);
    border-radius: 0;
    background: #ffffff;
    color: var(--color-foreground);
  }
  .s6trade-lookbook-modal__field input:focus {
    outline: 2px solid var(--color-foreground);
    outline-offset: -2px;
  }
  .s6trade-lookbook-modal__submit {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-primary-button-background);
    color: var(--color-primary-button-text);
    border: 1.5px solid var(--color-primary-button-border);
    border-radius: 0;
    padding: 14px 28px;
    font-family: var(--font-body--family);
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    cursor: pointer;
    margin-block-start: 4px;
  }
  .s6trade-lookbook-modal__submit:hover {
    background: var(--color-primary-button-hover-background);
    color: var(--color-primary-button-hover-text);
    border-color: var(--color-primary-button-hover-border);
  }
  .s6trade-lookbook-modal__fineprint {
    font-family: var(--font-body--family);
    font-size: 12px;
    line-height: 1.5;
    color: var(--color-foreground-muted);
    margin: 4px 0 0;
  }
  .s6trade-lookbook-modal__error {
    font-family: var(--font-body--family);
    font-size: 14px;
    color: #a33;
    line-height: 1.4;
  }
  .s6trade-lookbook-modal__success {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .s6trade-lookbook-modal__download {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-primary-button-background);
    color: var(--color-primary-button-text);
    border: 1.5px solid var(--color-primary-button-border);
    border-radius: 0;
    padding: 14px 28px;
    font-family: var(--font-body--family);
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    text-decoration: none;
    margin-block-start: 4px;
  }
  .s6trade-lookbook-modal__download:hover {
    background: var(--color-primary-button-hover-background);
    color: var(--color-primary-button-hover-text);
    border-color: var(--color-primary-button-hover-border);
  }
  @media (max-width: 480px) {
    .s6trade-lookbook-modal__panel {
      padding: 24px 20px;
    }
  }
{% endstylesheet %}

<script>
  (function () {
    var modal = document.getElementById('trade-lookbook');
    if (!modal) return;

    function openModal() {
      if (typeof modal.showModal === 'function') {
        if (!modal.open) modal.showModal();
      } else {
        modal.setAttribute('open', '');
      }
    }

    function closeModal() {
      if (typeof modal.close === 'function') {
        modal.close();
      } else {
        modal.removeAttribute('open');
      }
    }

    document.addEventListener('click', function (event) {
      var trigger = event.target.closest('a[href="#trade-lookbook"]');
      if (trigger) {
        event.preventDefault();
        openModal();
        return;
      }
      if (event.target.closest('[data-trade-lookbook-close]')) {
        event.preventDefault();
        closeModal();
        return;
      }
      if (event.target === modal) {
        closeModal();
      }
    });

    if (modal.querySelector('[data-trade-lookbook-success]')) {
      openModal();
    }
  })();
</script>

{% schema %}
{
  "name": "Trade Lookbook Modal",
  "tag": "section",
  "class": "s6trade-lookbook-modal-wrapper",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Form copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Free Download" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The 2026 Trade Lookbook" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Curated collections, real project case studies, and a complete product reference guide — every size, material, and frame option in one place. Made to help you source a full project without the guesswork.</p>" },
    { "type": "textarea", "id": "microcopy", "label": "Microcopy above fields", "default": "Tell us where to reach you and it's yours. We'll only follow up with things worth your time — new collections, trade events, the occasional resource like this one." },
    { "type": "text", "id": "submit_label", "label": "Submit button", "default": "Send me the lookbook" },
    { "type": "text", "id": "fineprint", "label": "Fineprint", "default": "By submitting, you agree to receive trade emails from Society6. Unsubscribe anytime." },
    { "type": "header", "content": "Success state" },
    { "type": "text", "id": "success_heading", "label": "Success heading", "default": "Your lookbook is ready" },
    { "type": "richtext", "id": "success_body", "label": "Success body", "default": "<p>Thanks — download your copy below. We'll be in touch with new collections and trade resources we think you'll want to see.</p>" },
    { "type": "text", "id": "success_link_label", "label": "Download link label", "default": "Download the 2026 Trade Lookbook (PDF)" },
    { "type": "url", "id": "pdf_url", "label": "Lookbook PDF URL", "default": "https://lfgr-marketplaces-email-images.s3.us-east-1.amazonaws.com/society6/2025/scheduled/trade/trade-assets/2026-S6-Trade-Lookbook-Web-Spreads.pdf" }
  ]
}
{% endschema %}
