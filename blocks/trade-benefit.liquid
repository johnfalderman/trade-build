{%- comment -%}
  blocks/trade-benefit.liquid
  Public block. A single benefit card with a thin-line icon, heading,
  and body copy. Used in the trade-benefits section's 3-column grid.
{%- endcomment -%}

{%- assign s = block.settings -%}

<div class="trade-benefit" {{ block.shopify_attributes }}>
  <div class="trade-benefit__icon" aria-hidden="true">
    {%- case s.icon -%}
      {%- when 'percent' -%}
        <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="9" cy="9" r="3" stroke="currentColor" stroke-width="1.5"/><circle cx="23" cy="23" r="3" stroke="currentColor" stroke-width="1.5"/><path d="M25 7L7 25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      {%- when 'curate' -%}
        <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M16 4L19.708 11.514L28 12.722L22 18.57L23.416 26.83L16 22.93L8.584 26.83L10 18.57L4 12.722L12.292 11.514L16 4Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
      {%- when 'invoice' -%}
        <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8 4H24V28L20 25L16 28L12 25L8 28V4Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M12 11H20M12 16H20M12 21H17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      {%- when 'ship' -%}
        <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 9H19V23H3V9Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M19 13H26L29 17V23H19V13Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><circle cx="8" cy="25" r="2" stroke="currentColor" stroke-width="1.5"/><circle cx="23" cy="25" r="2" stroke="currentColor" stroke-width="1.5"/></svg>
      {%- when 'frame' -%}
        <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="5" y="5" width="22" height="22" stroke="currentColor" stroke-width="1.5"/><rect x="9" y="9" width="14" height="14" stroke="currentColor" stroke-width="1.5"/></svg>
      {%- when 'person' -%}
        <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="16" cy="11" r="5" stroke="currentColor" stroke-width="1.5"/><path d="M6 27C6 21.477 10.477 17 16 17C21.523 17 26 21.477 26 27" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      {%- else -%}
        <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="16" cy="16" r="11" stroke="currentColor" stroke-width="1.5"/></svg>
    {%- endcase -%}
  </div>
  {%- if s.heading != blank -%}
    <h3 class="trade-benefit__heading">{{ s.heading | escape }}</h3>
  {%- endif -%}
  {%- if s.body != blank -%}
    <div class="trade-benefit__body">{{ s.body }}</div>
  {%- endif -%}
</div>

{% stylesheet %}
  .trade-benefit {
    display: flex;
    flex-direction: column;
    gap: 12px;
    color: var(--color-foreground);
  }
  .trade-benefit__icon {
    width: 32px;
    height: 32px;
    color: var(--color-foreground);
  }
  .trade-benefit__icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .trade-benefit__heading {
    font-family: var(--font-heading--family);
    font-size: 22px;
    font-weight: 600;
    line-height: 1.2;
    margin: 0;
    color: var(--color-foreground-heading);
  }
  .trade-benefit__body {
    font-family: var(--font-body--family);
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-foreground);
  }
  .trade-benefit__body :where(p) { margin: 0; }
{% endstylesheet %}

{% schema %}
{
  "name": "Trade Benefit",
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "percent", "label": "Percent" },
        { "value": "curate", "label": "Curate (star)" },
        { "value": "invoice", "label": "Invoice" },
        { "value": "ship", "label": "Ship" },
        { "value": "frame", "label": "Frame" },
        { "value": "person", "label": "Person" },
        { "value": "circle", "label": "Circle (generic)" }
      ],
      "default": "circle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body"
    }
  ],
  "presets": [
    { "name": "Trade Benefit" }
  ]
}
{% endschema %}
