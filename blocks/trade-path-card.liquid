{%- comment -%}
  blocks/trade-path-card.liquid
  Public theme block (no underscore prefix). Padded text card with tag,
  heading, body copy, and a single primary-style button. Used by the
  trade-two-path section to compose the Self-Serve vs Full-Service
  two-card grid. Strictly text-only — see brand/visual-system.md.
{%- endcomment -%}

{%- assign s = block.settings -%}

<div
  class="trade-path-card{% if s.inherit_color_scheme == false %} color-{{ s.color_scheme }}{% endif %}"
  {{ block.shopify_attributes }}
>
  {%- if s.tag != blank -%}
    <p class="trade-path-card__tag">{{ s.tag | escape }}</p>
  {%- endif -%}

  {%- if s.heading != blank -%}
    <h3 class="trade-path-card__heading">{{ s.heading | escape }}</h3>
  {%- endif -%}

  {%- if s.body != blank -%}
    <div class="trade-path-card__body">{{ s.body }}</div>
  {%- endif -%}

  <div class="trade-path-card__spacer" aria-hidden="true"></div>

  {%- if s.button_label != blank and s.button_link != blank -%}
    <a class="trade-path-card__button" href="{{ s.button_link }}">
      {{- s.button_label | escape -}}
    </a>
  {%- endif -%}
</div>

{% stylesheet %}
  .trade-path-card {
    display: flex;
    flex-direction: column;
    padding: 44px;
    border: 1px solid var(--color-border);
    border-radius: 0;
    background: var(--color-background);
    height: 100%;
    min-height: 320px;
  }

  .trade-path-card__tag {
    font-family: var(--font-accent--family);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-foreground-muted);
    margin: 0 0 16px 0;
  }

  .trade-path-card__heading {
    font-family: var(--font-heading--family);
    font-size: clamp(28px, 2.4vw, 34px);
    font-weight: 600;
    line-height: 1.15;
    margin: 0 0 16px 0;
    color: var(--color-foreground-heading);
  }

  .trade-path-card__body {
    font-family: var(--font-body--family);
    font-size: 17px;
    line-height: 1.5;
    color: var(--color-foreground);
    margin: 0 0 32px 0;
  }

  .trade-path-card__body :where(p) {
    margin: 0;
  }

  .trade-path-card__body :where(p) + :where(p) {
    margin-top: 0.75em;
  }

  .trade-path-card__spacer {
    flex: 1;
  }

  .trade-path-card__button {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-primary-button-background);
    color: var(--color-primary-button-text);
    border: 1.5px solid var(--color-primary-button-border);
    border-radius: 0;
    padding: 16px 32px;
    font-family: var(--font-body--family);
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .trade-path-card__button:hover {
    background: var(--color-primary-button-hover-background);
    color: var(--color-primary-button-hover-text);
    border-color: var(--color-primary-button-hover-border);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trade Path Card",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "tag",
      "label": "Tag",
      "info": "Small uppercase label above the heading (e.g. Self-Serve, Full-Service)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body copy"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "Inherit section color scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-trade-cream",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    }
  ],
  "presets": [
    {
      "name": "Trade Path Card"
    }
  ]
}
{% endschema %}
