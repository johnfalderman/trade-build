{%- comment -%}
  blocks/_trade-how-step.liquid
  Private block (underscore prefix). One numbered step in a how-it-works
  column. Renders a bordered circle with the step number, a heading, and
  a body paragraph.
{%- endcomment -%}

{%- assign s = block.settings -%}

<div class="trade-how-step" {{ block.shopify_attributes }}>
  <div class="trade-how-step__num" aria-hidden="true">{{ s.number | default: forloop.index | escape }}</div>
  <div class="trade-how-step__copy">
    {%- if s.heading != blank -%}
      <h4 class="trade-how-step__heading">{{ s.heading | escape }}</h4>
    {%- endif -%}
    {%- if s.body != blank -%}
      <div class="trade-how-step__body">{{ s.body }}</div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .trade-how-step {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 20px;
    align-items: start;
  }
  .trade-how-step__num {
    width: 44px;
    height: 44px;
    border: 1.5px solid var(--color-foreground);
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading--family);
    font-size: 18px;
    font-weight: 600;
    color: var(--color-foreground-heading);
  }
  .trade-how-step__heading {
    font-family: var(--font-body--family);
    font-size: 17px;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 6px 0;
    color: var(--color-foreground-heading);
  }
  .trade-how-step__body {
    font-family: var(--font-body--family);
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-foreground);
  }
  .trade-how-step__body :where(p) { margin: 0; }
{% endstylesheet %}

{% schema %}
{
  "name": "How-It-Works Step",
  "settings": [
    { "type": "text", "id": "number", "label": "Number (optional override)" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Body" }
  ]
}
{% endschema %}
