      "blocks": {
        "media": {
          "type": "_media-without-appearance",
          "static": true,
          "settings": {
            "media_type": "image",
            "image": "shopify://shop_images/photo-1556228453-efd6c1ff04f6.jpg",
            "image_position": "cover"
          }
        },
        "content": {
          "type": "_content-without-appearance",
          "static": true,
          "settings": {
            "horizontal_alignment_flex_direction_column": "flex-start",
            "vertical_alignment_flex_direction_column": "center",
            "gap": 20
          },
          "blocks": {
            "eyebrow": {
              "type": "text",
              "settings": {
                "text": "<p>Society6 Trade Program</p>",
                "type_preset": "h6",
                "alignment": "left",
                "font": "var(--font-accent--family)",
                "font_size": "0.85rem",
                "case": "uppercase",
                "letter_spacing": "0.18em"
              }
            },
            "headline": {
              "type": "text",
              "settings": {
                "text": "<h1>Art for Every Project.<br>Sourced, Curated, Delivered.</h1>",
                "type_preset": "h1",
                "alignment": "left",
                "max_width": "narrow",
                "font": "var(--font-heading--family)"
              }
            },
            "subhead": {
              "type": "text",
              "settings": {
                "text": "<p>30% trade pricing on handpicked Wall Art, Home Decor, and lifestyle. Source direct or have our curation team build a collection for your project.</p>",
                "type_preset": "rte",
                "alignment": "left",
                "max_width": "normal"
              }
            },
            "button_primary": {
              "type": "button",
              "settings": {
                "label": "Join Trade Program",
                "link": "shopify://pages/trade-application"
              }
            },
            "button_secondary": {
              "type": "button",
              "settings": {
                "label": "Learn More",
                "link": "#",
                "style_class": "button-secondary"
              }
            }
          },
          "block_order": ["eyebrow", "headline", "subhead", "button_primary", "button_secondary"]
        }
      },
      "settings": {
        "media_position": "right",
        "media_width": "medium",
        "media_height": "auto",
        "section_width": "page-width",
        "extend_media": false,
        "color_scheme": "scheme-trade-cream",
        "padding-block-start": 44,
        "padding-block-end": 44
      }
