                "font": "var(--font-accent--family)",
                "font_size": "0.85rem",
                "case": "uppercase",
                "letter_spacing": "0.18em"
              }
            },
            "headline": {
              "type": "text",
              "settings": {
                "text": "<h1>Art for Every Project.<br>Sourced, Curated, Delivered.</h1>",
                "type_preset": "h1",
                "alignment": "left",
                "max_width": "narrow",
                "font": "var(--font-heading--family)"
              }
            },
            "subhead": {
              "type": "text",
              "settings": {
                "text": "<p>30% trade pricing on handpicked Wall Art, Home Decor, and lifestyle. Source direct or have our curation team build a collection for your project.</p>",
