    "two-path": {
      "type": "trade-two-path",
      "blocks": {
        "self-serve-card": {
          "type": "trade-path-card",
          "settings": {
            "tag": "Self-Serve",
            "heading": "Source, choose, ship.",
            "body": "<p>Explore the handpicked catalog at your own pace. 30% trade discount applies automatically — no codes, no minimums, no waiting. Add to cart and go.</p>",
            "button_label": "Join Trade Program",
            "button_link": "shopify://pages/trade-application"
          }
        },
        "full-service-card": {
          "type": "trade-path-card",
          "settings": {
            "tag": "Full-Service",
            "heading": "We do the sourcing for you.",
            "body": "<p>Share your mood board and project brief. Our curation team does the sourcing, recommends framing and sizing, and delivers a custom collection for your review. You approve, we produce.</p>",
            "button_label": "Request a Curated Collection",
            "button_link": "#"
          }
        }
      },
      "block_order": ["self-serve-card", "full-service-card"],
      "settings": {
        "eyebrow": "Your Way, Your Pace",
        "heading": "Two ways to source curated art for your project.",
        "subhead": "<p>Society6 is a curated art retailer — we handpick artists and designs across Wall Art, Home Decor, and lifestyle products, unlike open marketplaces with unlimited uploads. Run with it yourself, or hand the brief to our curation team. Either way, your 30% trade discount applies.</p>",
        "section_width": "page-width",
        "color_scheme": "scheme-trade-cream"
      }
    },
    "benefits": {
      "type": "trade-benefits",
      "blocks": {
        "b1": { "type": "trade-benefit", "settings": { "icon": "percent", "heading": "30% off everything", "body": "<p>Browse and buy in minutes — no approval gate, no minimums.</p>" } },
        "b2": { "type": "trade-benefit", "settings": { "icon": "curate", "heading": "We do the sourcing for you", "body": "<p>We'll build a custom collection to your brief, free of charge.</p>" } },
        "b3": { "type": "trade-benefit", "settings": { "icon": "invoice", "heading": "One order, one invoice", "body": "<p>Consolidated POs across multiple pieces, artists, and frame styles.</p>" } },
        "b4": { "type": "trade-benefit", "settings": { "icon": "ship", "heading": "Ships from the U.S.", "body": "<p>Faster timelines, easier returns, no import complexity.</p>" } },
        "b5": { "type": "trade-benefit", "settings": { "icon": "frame", "heading": "Frame to spec", "body": "<p>Custom sizes and finishes that fit your exact space.</p>" } },
        "b6": { "type": "trade-benefit", "settings": { "icon": "person", "heading": "A real person on your project", "body": "<p>Whether you're browsing solo or working with our curation team.</p>" } }
      },
      "block_order": ["b1", "b2", "b3", "b4", "b5", "b6"],
      "settings": {
        "eyebrow": "What's Included",
        "heading": "Built for the way designers actually work.",
        "section_width": "page-width",
        "color_scheme": "scheme-trade-cream"
